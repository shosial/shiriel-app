# Copy to .env for local work. Never commit real values.
# Stage 1 (skeleton) needs only these. Each later stage adds its own variables here.

PORT=3000
# The app's address, without a trailing slash (e.g. https://app.example.co.il)
PUBLIC_URL=http://localhost:3000
# Long random string. Render generates it. Signs the login cookie and encrypts saved secrets.
SESSION_SECRET=
# Supabase → Project Settings → Database → Connection string → Session pooler. Empty = run without a database.
DATABASE_URL=
# Admin emails, separated by commas
ADMIN_EMAILS=
# Tests only: an EMPTY database. The tests wipe it. Never production.
TEST_DATABASE_URL=
