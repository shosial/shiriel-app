{
  "name": "shiriel-app",
  "version": "0.1.0",
  "private": true,
  "description": "האפליקציה של שיריאל תורג'מן: גיוס לקוחות, ניתוח שיחות מכירה וניהול לקוחות. אתר שמותקן כאפליקציה (PWA) לאייפון ולאנדרואיד.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "routes:update": "UPDATE_ROUTES=1 node --test test/routes.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  }
}
